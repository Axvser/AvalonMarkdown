<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="clr-namespace:AvalonMarkdown.ViewModels"
			 x:Class="AvalonMarkdown.Views.MarkdownThemeView"
			 x:DataType="vm:MarkdownThemeViewModel">
  <UserControl.Styles>
      <!-- Card surface (adaptive: subtle light overlay + hairline border) -->
      <Style Selector="Border.card">
        <Setter Property="Background" Value="#0DFFFFFF"/>
        <Setter Property="BorderBrush" Value="#26FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="11,9,11,10"/>
      </Style>
      <!-- Rounded color swatch -->
      <Style Selector="Border.swatch">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderBrush" Value="#3DFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <!-- Group title -->
      <Style Selector="TextBlock.gtitle">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <!-- HEX readout -->
      <Style Selector="TextBlock.ghex">
        <Setter Property="FontFamily" Value="Consolas, monospace"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Opacity" Value="0.6"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <!-- R/G/B channel letter -->
      <Style Selector="TextBlock.chlbl">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <!-- numeric readout -->
      <Style Selector="TextBlock.cval">
        <Setter Property="FontFamily" Value="Consolas, monospace"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Opacity" Value="0.85"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Right"/>
      </Style>
      <!-- field label -->
      <Style Selector="TextBlock.flbl">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      </Style>
      <!-- Slim theme sliders -->
      <Style Selector="Slider">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="MinHeight" Value="20"/>
      </Style>
      <!-- Group header in the editor -->
      <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Opacity" Value="0.55"/>
        <Setter Property="Margin" Value="4,8,0,0"/>
      </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- ═══ Collapsible toggle header ═══ -->
    <Border x:Name="ToggleHeader"
            DockPanel.Dock="Top"
            Cursor="Hand"
            Background="{DynamicResource SystemChromeLowColor}"
            CornerRadius="8"
            Padding="12,7">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <TextBlock x:Name="ArrowCollapsed" Text="▸" FontSize="11"
                   Foreground="{DynamicResource SystemAccentColor}"
                   VerticalAlignment="Center"/>
        <TextBlock x:Name="ArrowExpanded" Text="▾" FontSize="11"
                   Foreground="{DynamicResource SystemAccentColor}"
                   VerticalAlignment="Center" IsVisible="False"/>
        <TextBlock Grid.Column="1" Text="Theme Editor"
                   FontSize="12" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="8,0,0,0"/>
        <Border Grid.Column="3" CornerRadius="9" Padding="8,1"
                VerticalAlignment="Center" Background="{DynamicResource SystemAccentColor}" Opacity="0.16">
          <TextBlock Text="auto-apply" FontSize="9" FontWeight="SemiBold"
                     Foreground="{DynamicResource SystemAccentColor}"
                     VerticalAlignment="Center"/>
        </Border>
      </Grid>
    </Border>

    <!-- ═══ Collapsible content ═══ -->
    <ScrollViewer x:Name="ContentPanel" MaxHeight="340" IsVisible="False">
      <StackPanel Margin="6" Spacing="10">

        <TextBlock Classes="section" Text="PAGE"/>

        <!-- ───────── Base colors ───────── -->
        <Border Classes="card">
          <StackPanel Spacing="3">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,2">
              <Border Classes="swatch" Background="{Binding BgHex}"/>
              <TextBlock Classes="gtitle" Grid.Column="1" Margin="10,0,0,0" Text="Background"/>
              <TextBlock Classes="ghex" Grid.Column="2" Text="{Binding BgHex}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#ff6b6b" Text="R"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding BgR}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding BgR}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#7bd88f" Text="G"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding BgG}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding BgG}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#5aa7f0" Text="B"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding BgB}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding BgB}"/>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Classes="section" Text="TEXT"/>

        <Border Classes="card">
          <StackPanel Spacing="3">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,2">
              <Border Classes="swatch" Background="{Binding TextHex}"/>
              <TextBlock Classes="gtitle" Grid.Column="1" Margin="10,0,0,0" Text="Text"/>
              <TextBlock Classes="ghex" Grid.Column="2" Text="{Binding TextHex}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#ff6b6b" Text="R"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding TextR}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding TextR}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#7bd88f" Text="G"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding TextG}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding TextG}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#5aa7f0" Text="B"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding TextB}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding TextB}"/>
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="3">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,2">
              <Border Classes="swatch" Background="{Binding LinkHex}"/>
              <TextBlock Classes="gtitle" Grid.Column="1" Margin="10,0,0,0" Text="Link"/>
              <TextBlock Classes="ghex" Grid.Column="2" Text="{Binding LinkHex}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#ff6b6b" Text="R"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding LinkR}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding LinkR}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#7bd88f" Text="G"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding LinkG}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding LinkG}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#5aa7f0" Text="B"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding LinkB}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding LinkB}"/>
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="3">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,2">
              <Border Classes="swatch" Background="{Binding HeadingHex}"/>
              <TextBlock Classes="gtitle" Grid.Column="1" Margin="10,0,0,0" Text="Heading"/>
              <TextBlock Classes="ghex" Grid.Column="2" Text="{Binding HeadingHex}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#ff6b6b" Text="R"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding HeadingR}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding HeadingR}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#7bd88f" Text="G"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding HeadingG}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding HeadingG}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#5aa7f0" Text="B"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding HeadingB}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding HeadingB}"/>
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="3">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,2">
              <Border Classes="swatch" Background="{Binding CodeHex}"/>
              <TextBlock Classes="gtitle" Grid.Column="1" Margin="10,0,0,0" Text="Inline Code"/>
              <TextBlock Classes="ghex" Grid.Column="2" Text="{Binding CodeHex}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#ff6b6b" Text="R"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding CodeR}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding CodeR}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#7bd88f" Text="G"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding CodeG}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding CodeG}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#5aa7f0" Text="B"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding CodeB}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding CodeB}"/>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Classes="section" Text="SURFACES"/>

        <Border Classes="card">
          <StackPanel Spacing="3">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,2">
              <Border Classes="swatch" Background="{Binding BorderHex}"/>
              <TextBlock Classes="gtitle" Grid.Column="1" Margin="10,0,0,0" Text="Border"/>
              <TextBlock Classes="ghex" Grid.Column="2" Text="{Binding BorderHex}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#ff6b6b" Text="R"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding BorderR}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding BorderR}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#7bd88f" Text="G"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding BorderG}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding BorderG}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#5aa7f0" Text="B"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding BorderB}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding BorderB}"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- ───────── Surfaces ───────── -->
        <Border Classes="card">
          <StackPanel Spacing="3">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,2">
              <Border Classes="swatch" Background="{Binding BgSecHex}"/>
              <TextBlock Classes="gtitle" Grid.Column="1" Margin="10,0,0,0" Text="Secondary Background"/>
              <TextBlock Classes="ghex" Grid.Column="2" Text="{Binding BgSecHex}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#ff6b6b" Text="R"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding BgSecR}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding BgSecR}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#7bd88f" Text="G"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding BgSecG}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding BgSecG}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#5aa7f0" Text="B"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding BgSecB}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding BgSecB}"/>
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="3">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,2">
              <Border Classes="swatch" Background="{Binding TextSecHex}"/>
              <TextBlock Classes="gtitle" Grid.Column="1" Margin="10,0,0,0" Text="Secondary Text"/>
              <TextBlock Classes="ghex" Grid.Column="2" Text="{Binding TextSecHex}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#ff6b6b" Text="R"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding TextSecR}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding TextSecR}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#7bd88f" Text="G"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding TextSecG}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding TextSecG}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#5aa7f0" Text="B"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding TextSecB}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding TextSecB}"/>
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="3">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,2">
              <Border Classes="swatch" Background="{Binding CodeBgHex}"/>
              <TextBlock Classes="gtitle" Grid.Column="1" Margin="10,0,0,0" Text="Inline Code Background"/>
              <TextBlock Classes="ghex" Grid.Column="2" Text="{Binding CodeBgHex}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#ff6b6b" Text="R"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding CodeBgR}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding CodeBgR}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#7bd88f" Text="G"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding CodeBgG}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding CodeBgG}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#5aa7f0" Text="B"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding CodeBgB}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding CodeBgB}"/>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Classes="section" Text="CODE"/>

        <Border Classes="card">
          <StackPanel Spacing="3">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,2">
              <Border Classes="swatch" Background="{Binding PreBgHex}"/>
              <TextBlock Classes="gtitle" Grid.Column="1" Margin="10,0,0,0" Text="Code Block Background"/>
              <TextBlock Classes="ghex" Grid.Column="2" Text="{Binding PreBgHex}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#ff6b6b" Text="R"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding PreBgR}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding PreBgR}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#7bd88f" Text="G"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding PreBgG}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding PreBgG}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#5aa7f0" Text="B"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding PreBgB}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding PreBgB}"/>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Classes="section" Text="TABLES"/>

        <Border Classes="card">
          <StackPanel Spacing="3">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,2">
              <Border Classes="swatch" Background="{Binding TableBgHex}"/>
              <TextBlock Classes="gtitle" Grid.Column="1" Margin="10,0,0,0" Text="Table Header"/>
              <TextBlock Classes="ghex" Grid.Column="2" Text="{Binding TableBgHex}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#ff6b6b" Text="R"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding TableBgR}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding TableBgR}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#7bd88f" Text="G"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding TableBgG}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding TableBgG}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#5aa7f0" Text="B"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding TableBgB}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding TableBgB}"/>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Classes="section" Text="TYPOGRAPHY"/>

        <!-- ───────── Typography ───────── -->
        <Border Classes="card">
          <StackPanel Spacing="4">
            <TextBlock Classes="gtitle" Text="Typography" Margin="0,0,0,3"/>
            <Grid ColumnDefinitions="112,*,44" ColumnSpacing="8">
              <TextBlock Classes="flbl" Text="Code font size"/>
              <Slider Grid.Column="1" Minimum="8" Maximum="24" Value="{Binding CodeFontSize}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding CodeFontSize}"/>
            </Grid>
            <Grid ColumnDefinitions="112,*,44" ColumnSpacing="8">
              <TextBlock Classes="flbl" Text="Corner radius"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="20" Value="{Binding BorderRadius}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding BorderRadius}"/>
            </Grid>
            <Grid ColumnDefinitions="112,*,44" ColumnSpacing="8">
              <TextBlock Classes="flbl" Text="Heading margin top"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="48" Value="{Binding HeadingMarginTop}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding HeadingMarginTop}"/>
            </Grid>
            <Grid ColumnDefinitions="112,*,44" ColumnSpacing="8">
              <TextBlock Classes="flbl" Text="Heading margin bottom"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="48" Value="{Binding HeadingMarginBottom}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding HeadingMarginBottom}"/>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Classes="section" Text="DIAGRAMS"/>

        <!-- ───────── Mermaid ───────── -->
        <Border Classes="card">
          <StackPanel Spacing="3">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,2">
              <Border Classes="swatch" Background="{Binding MermaidBgHex}"/>
              <TextBlock Classes="gtitle" Grid.Column="1" Margin="10,0,0,0" Text="Mermaid"/>
              <TextBlock Classes="ghex" Grid.Column="2" Text="{Binding MermaidBgHex}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#ff6b6b" Text="R"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding MermaidBgR}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding MermaidBgR}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#7bd88f" Text="G"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding MermaidBgG}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding MermaidBgG}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#5aa7f0" Text="B"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding MermaidBgB}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding MermaidBgB}"/>
            </Grid>
            <Grid ColumnDefinitions="112,*,44" ColumnSpacing="8" Margin="0,4,0,0">
              <TextBlock Classes="flbl" Text="Container padding"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="32" Value="{Binding MermaidContainerPadding}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding MermaidContainerPadding}"/>
            </Grid>
            <Grid ColumnDefinitions="112,*,44" ColumnSpacing="8">
              <TextBlock Classes="flbl" Text="Container margin"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="48" Value="{Binding MermaidContainerMargin}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding MermaidContainerMargin}"/>
            </Grid>
            <Grid ColumnDefinitions="112,*,44" ColumnSpacing="8">
              <TextBlock Classes="flbl" Text="Corner radius"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="20" Value="{Binding MermaidBorderRadius}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding MermaidBorderRadius}"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- ───────── PlantUML ───────── -->
        <Border Classes="card">
          <StackPanel Spacing="3">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,2">
              <Border Classes="swatch" Background="{Binding PumlBgHex}"/>
              <TextBlock Classes="gtitle" Grid.Column="1" Margin="10,0,0,0" Text="PlantUML"/>
              <TextBlock Classes="ghex" Grid.Column="2" Text="{Binding PumlBgHex}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#ff6b6b" Text="R"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding PumlBgR}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding PumlBgR}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#7bd88f" Text="G"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding PumlBgG}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding PumlBgG}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#5aa7f0" Text="B"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding PumlBgB}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding PumlBgB}"/>
            </Grid>
            <Grid ColumnDefinitions="112,*,44" ColumnSpacing="8" Margin="0,4,0,0">
              <TextBlock Classes="flbl" Text="Container padding"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="32" Value="{Binding PumlContainerPadding}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding PumlContainerPadding}"/>
            </Grid>
            <Grid ColumnDefinitions="112,*,44" ColumnSpacing="8">
              <TextBlock Classes="flbl" Text="Container margin"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="48" Value="{Binding PumlContainerMargin}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding PumlContainerMargin}"/>
            </Grid>
            <Grid ColumnDefinitions="112,*,44" ColumnSpacing="8">
              <TextBlock Classes="flbl" Text="Dark invert"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding PumlDarkInvert}" IsSnapToTickEnabled="True" TickFrequency="0.01"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding PumlDarkInvert, StringFormat={}{0:0.000}}"/>
            </Grid>
            <Grid ColumnDefinitions="112,*,44" ColumnSpacing="8">
              <TextBlock Classes="flbl" Text="Corner radius"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="20" Value="{Binding PumlBorderRadius}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding PumlBorderRadius}"/>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Classes="section" Text="FUNCTION PLOTS"/>

        <!-- ───────── Function Plots ───────── -->
        <Border Classes="card">
          <StackPanel Spacing="3">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,2">
              <Border Classes="swatch" Background="{Binding PlotBgHex}"/>
              <TextBlock Classes="gtitle" Grid.Column="1" Margin="10,0,0,0" Text="Function Plots"/>
              <TextBlock Classes="ghex" Grid.Column="2" Text="{Binding PlotBgHex}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#ff6b6b" Text="R"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding PlotBgR}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding PlotBgR}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#7bd88f" Text="G"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding PlotBgG}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding PlotBgG}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#5aa7f0" Text="B"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding PlotBgB}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding PlotBgB}"/>
            </Grid>
            <Grid ColumnDefinitions="112,*,44" ColumnSpacing="8" Margin="0,4,0,0">
              <TextBlock Classes="flbl" Text="Container padding"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="32" Value="{Binding PlotContainerPadding}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding PlotContainerPadding}"/>
            </Grid>
            <Grid ColumnDefinitions="112,*,44" ColumnSpacing="8">
              <TextBlock Classes="flbl" Text="Container margin"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="48" Value="{Binding PlotContainerMargin}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding PlotContainerMargin}"/>
            </Grid>
            <Grid ColumnDefinitions="112,*,44" ColumnSpacing="8">
              <TextBlock Classes="flbl" Text="Corner radius"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="20" Value="{Binding PlotBorderRadius}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding PlotBorderRadius}"/>
            </Grid>
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,6,0,2">
              <Border Classes="swatch" Background="{Binding PlotAxisColor}"/>
              <TextBlock Grid.Column="1" Classes="gtitle" Margin="10,0,0,0" Text="Axis colour"/>
              <TextBlock Grid.Column="2" Classes="ghex" Text="{Binding PlotAxisColor}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#ff6b6b" Text="R"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding PlotAxisR}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding PlotAxisR}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#7bd88f" Text="G"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding PlotAxisG}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding PlotAxisG}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#5aa7f0" Text="B"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding PlotAxisB}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding PlotAxisB}"/>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Classes="section" Text="CHAT / STATUS"/>

        <!-- ───────── Chat / status blocks ───────── -->
        <Border Classes="card">
          <StackPanel Spacing="3">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,2">
              <Border Classes="swatch" Background="{Binding ChatBgHex}"/>
              <TextBlock Classes="gtitle" Grid.Column="1" Margin="10,0,0,0" Text="Chat / Status"/>
              <TextBlock Classes="ghex" Grid.Column="2" Text="{Binding ChatBgHex}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#ff6b6b" Text="R"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding ChatBgR}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding ChatBgR}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#7bd88f" Text="G"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding ChatBgG}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding ChatBgG}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#5aa7f0" Text="B"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding ChatBgB}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding ChatBgB}"/>
            </Grid>
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,6,0,2">
              <Border Classes="swatch" Background="{Binding ChatAccentColor}"/>
              <TextBlock Grid.Column="1" Classes="gtitle" Margin="10,0,0,0" Text="Badge colour"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#ff6b6b" Text="R"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding ChatAccentR}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding ChatAccentR}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#7bd88f" Text="G"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding ChatAccentG}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding ChatAccentG}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#5aa7f0" Text="B"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding ChatAccentB}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding ChatAccentB}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Text="A"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding ChatAccentA}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding ChatAccentA}"/>
            </Grid>
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,6,0,2">
              <Border Classes="swatch" Background="{Binding ChatGlassColor}"/>
              <TextBlock Grid.Column="1" Classes="gtitle" Margin="10,0,0,0" Text="Glow colour"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#ff6b6b" Text="R"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding ChatGlassR}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding ChatGlassR}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#7bd88f" Text="G"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding ChatGlassG}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding ChatGlassG}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Foreground="#5aa7f0" Text="B"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding ChatGlassB}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding ChatGlassB}"/>
            </Grid>
            <Grid ColumnDefinitions="14,*,34" ColumnSpacing="8">
              <TextBlock Classes="chlbl" Text="A"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding ChatGlassA}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding ChatGlassA}"/>
            </Grid>
            <Grid ColumnDefinitions="112,*,44" ColumnSpacing="8" Margin="0,4,0,0">
              <TextBlock Classes="flbl" Text="Body padding"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="32" Value="{Binding ChatContainerPadding}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding ChatContainerPadding}"/>
            </Grid>
            <Grid ColumnDefinitions="112,*,44" ColumnSpacing="8">
              <TextBlock Classes="flbl" Text="Container margin"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="48" Value="{Binding ChatContainerMargin}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding ChatContainerMargin}"/>
            </Grid>
            <Grid ColumnDefinitions="112,*,44" ColumnSpacing="8">
              <TextBlock Classes="flbl" Text="Right radius"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="20" Value="{Binding ChatBorderRadius}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding ChatBorderRadius}"/>
            </Grid>
            <Grid ColumnDefinitions="112,*,44" ColumnSpacing="8">
              <TextBlock Classes="flbl" Text="Glow blur"/>
              <Slider Grid.Column="1" Minimum="0" Maximum="20" Value="{Binding ChatGlassBlur}" IsSnapToTickEnabled="True" TickFrequency="1"/>
              <TextBlock Classes="cval" Grid.Column="2" Text="{Binding ChatGlassBlur}"/>
            </Grid>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
